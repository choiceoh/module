<?xml version="1.0" encoding="UTF-8"?>
<!--
  sojeongcompose — 국악기(Korean traditional instruments) 정의

  MuseScore 하드 포크의 instruments.xml 에 병합하거나, MuseScore
  Preferences → Score → "Instrument list" 에서 커스텀 목록으로 지정해 사용한다.

  값 규칙(MuseScore instruments.xml):
    - aPitchRange / pPitchRange : MIDI 번호 (예: 60 = 가온다/C4)
    - clef : G(높은음자리), F(낮은음자리), PERC(타악기)
    - genre : 새 악보 마법사의 카테고리 필터. genre 가 없으면 "전체 악기"에서만
      보이므로, 전용 장르 <Genre id="gukak"> 를 정의하고 각 악기에 부여한다.
    - id : 업스트림과 충돌하지 않도록 모두 "sojeong-" 접두(예: 업스트림이 이미
      danso 를 제공 → 충돌 시 stock 정의가 우선될 수 있음).
    - musicXMLid : Finale 등과의 MusicXML 호환용 표준 sound id (근사값)
    - <Channel><program> : Decent Sampler(조선 시리즈) VST 를 믹서에서 연결하기
      전까지 쓰는 GM 폴백 음색 (0-based). VST 연결 후에는 무시된다.

  ⚠ 음역(range)·이조는 유파/악기마다 달라 "합리적 근사값"이다.
     프로 작곡가가 docs/instrument-ranges.md 기준으로 조정해 확정한다.
-->
<museScore version="4.40">
  <!-- 국악 전용 장르(업스트림 world 등과 충돌 방지용 고유 id).
       업스트림 instruments.xml 에 병합 시, 동일 id 가 없으면 그대로 추가된다. -->
  <Genre id="gukak">
    <name>국악 (Korean Traditional)</name>
  </Genre>

  <InstrumentGroup id="sojeong-gukak">
