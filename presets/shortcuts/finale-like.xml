<?xml version="1.0" encoding="UTF-8"?>
<!--
  sojeongcompose — Finale식 단축키 프리셋 (MuseScore shortcuts.xml)

  설치: docs/없이 바로 적용하려면 이 파일을 MuseScore 설정 폴더의 shortcuts.xml
  로 복사하거나, MuseScore에서 Edit → Preferences → Shortcuts → (가져오기)로 불러온다.
    - Windows : %LOCALAPPDATA%\MuseScore\MuseScore4\shortcuts.xml
    - macOS   : ~/Library/Application Support/MuseScore/MuseScore4/shortcuts.xml
    - Linux   : ${XDG_DATA_HOME:-~/.local/share}/MuseScore/MuseScore4/shortcuts.xml

  형식: <Shortcut><key>액션ID</key><seq>키시퀀스</seq></Shortcut>

  ※ 아래 음가/기본 입력 키는 MuseScore 기본값이 이미 Finale Speedy(5=4분음표)와
    일치하므로, 이 프리셋은 그것을 "고정"하고 Finale 사용자가 헷갈리지 않게 명시한다.
  ⚠ 비음가 명령(아티큘레이션·이동 등)의 정확한 액션ID는 버전마다 다를 수 있으니,
    빌드된 sojeongcompose에서 Preferences → Shortcuts로 확인·보정한 뒤 export 해
    이 파일을 확정한다(docs/finale-to-sojeong.md의 키별 점검표 참고).
-->
<museScore version="4.40">
  <!-- 음표 입력 토글 -->
  <Shortcut><key>note-input</key><seq>N</seq></Shortcut>

  <!-- 음가 선택: Finale Speedy와 동일 (숫자 = 짧은→긴, 5 = 4분음표) -->
  <Shortcut><key>pad-note-64</key><seq>1</seq></Shortcut>
  <Shortcut><key>pad-note-32</key><seq>2</seq></Shortcut>
  <Shortcut><key>pad-note-16</key><seq>3</seq></Shortcut>
  <Shortcut><key>pad-note-8</key><seq>4</seq></Shortcut>
  <Shortcut><key>pad-note-4</key><seq>5</seq></Shortcut>
  <Shortcut><key>pad-note-2</key><seq>6</seq></Shortcut>
  <Shortcut><key>pad-note-1</key><seq>7</seq></Shortcut>
  <Shortcut><key>pad-dot</key><seq>.</seq></Shortcut>

  <!-- 쉼표 / 붙임줄 / 이음줄 -->
  <Shortcut><key>rest</key><seq>0</seq></Shortcut>
  <Shortcut><key>tie</key><seq>T</seq></Shortcut>
  <Shortcut><key>add-slur</key><seq>S</seq></Shortcut>

  <!-- 셋잇단음표 -->
  <Shortcut><key>triplet</key><seq>Ctrl+3</seq></Shortcut>

  <!-- 마디 끝에 추가 -->
  <Shortcut><key>append-measure</key><seq>Ctrl+B</seq></Shortcut>

  <!-- 장단 입력 플러그인 빠른 실행(액션ID는 플러그인 등록 후 확정) -->
  <!-- <Shortcut><key>plugin-jangdan</key><seq>Ctrl+Shift+J</seq></Shortcut> -->
</museScore>
